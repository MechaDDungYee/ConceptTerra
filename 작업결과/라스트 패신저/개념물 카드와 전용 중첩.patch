+  assert.equal(livingForm(f,'enemy').stacks['인양의 명패'],1);
+  const before=livingForm(f,'enemy').hp;
+  configureBattle(f,(b,self)=>{
+    self.hand=[cleanup];self.mind=50;b.units.enemy.pos=18;b.units.enemy.blockedRounds=1;
+  });
